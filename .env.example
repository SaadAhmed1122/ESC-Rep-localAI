# ESG Local AI — copy to .env (or export) and adjust. All values are optional.

# Model runtime: ollama | openai_compat | fake
ESGLOCAL_PROVIDER=ollama
ESGLOCAL_BASE_URL=http://127.0.0.1:11434
# ESGLOCAL_CHAT_MODEL=qwen2.5:7b
ESGLOCAL_EMBED_MODEL=nomic-embed-text
ESGLOCAL_TEMPERATURE=0.2
ESGLOCAL_NUM_CTX=8192
ESGLOCAL_THINK=0

# Privacy
ESGLOCAL_OFFLINE=1
# Only add hosts you trust, e.g. the "ollama" service in docker-compose:
# ESGLOCAL_ALLOWED_HOSTS=ollama
ESGLOCAL_REDACT_PII=1

# Storage
# ESGLOCAL_HOME=~/.esglocal
# ESGLOCAL_PASSPHRASE=change-me-to-a-long-unique-passphrase

# Agents
ESGLOCAL_AGENT_MAX_STEPS=6
ESGLOCAL_AGENT_CONCURRENCY=1
